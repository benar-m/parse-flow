# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require&channel_binding=require


# Application Configuration
PORT=5000
RAW_LOG_CHAN_SIZE=1000
PARSED_LOG_CHAN_SIZE=1000
METRIC_CHAN_SIZE=100
BATCH_SIZE=100
FLUSH_INTERVAL=5s
SNAPSHOT_INTERVAL=1m
METRICS_API_KEY=your_metrics_api_key_here
